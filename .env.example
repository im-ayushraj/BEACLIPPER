# ==============================================================================
# CLIPPER PRODUCTION SAAS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your production credentials.
# All components include automatic local development fallbacks if keys are omitted.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Production PostgreSQL URI (e.g. Supabase, Neon, AWS RDS)
# If omitted, defaults to local SQLite at sqlite:///./clipper_dev.db
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Optional: Supabase Direct Credentials (for Supabase Storage & PostgREST sync)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-KEY]

# ------------------------------------------------------------------------------
# 2. AI & LARGE LANGUAGE MODEL (Google Gemini 2.5)
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key for moment identification & audio transcription
GEMINI_API_KEY=AIzaSy[YOUR-GEMINI-KEY]

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Clerk)
# ------------------------------------------------------------------------------
# Clerk authentication keys for frontend & backend JWT verification
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_[YOUR-CLERK-KEY]
CLERK_SECRET_KEY=sk_test_[YOUR-CLERK-SECRET]

# ------------------------------------------------------------------------------
# 4. CLOUD OBJECT STORAGE (Cloudflare R2 / AWS S3 / MinIO)
# ------------------------------------------------------------------------------
# Set these to enable cloud object storage with time-limited presigned download URLs.
# Works natively with AWS S3, Cloudflare R2, Wasabi, or MinIO.
# For Cloudflare R2: S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# For AWS S3: leave S3_ENDPOINT_URL empty and specify S3_REGION_NAME
S3_ENDPOINT_URL=https://[ACCOUNT-ID].r2.cloudflarestorage.com
S3_BUCKET_NAME=clipper-media-production
AWS_ACCESS_KEY_ID=[YOUR-ACCESS-KEY-ID]
AWS_SECRET_ACCESS_KEY=[YOUR-SECRET-ACCESS-KEY]
S3_REGION_NAME=auto
S3_PRESIGNED_EXPIRATION_SECONDS=86400

# ------------------------------------------------------------------------------
# 5. MONETIZATION & BILLING (Stripe)
# ------------------------------------------------------------------------------
# Stripe API Keys (Live or Test Mode)
# If omitted, Stripe operates in local sandbox mode with mock redirects.
STRIPE_SECRET_KEY=sk_live_[YOUR-STRIPE-SECRET-KEY]
STRIPE_WEBHOOK_SECRET=whsec_[YOUR-WEBHOOK-SECRET]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_[YOUR-STRIPE-PUBLISHABLE-KEY]

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL NOTIFICATIONS (Resend Email API)
# ------------------------------------------------------------------------------
# Resend API key for dispatching clip completion and failure alerts
# If omitted, notifications gracefully output to console logs.
RESEND_API_KEY=re_[YOUR-RESEND-KEY]
NOTIFICATION_FROM_EMAIL=Clipper AI <notifications@beaclipper.com>

# ------------------------------------------------------------------------------
# 7. PRODUCTION NETWORKING & LIMITS
# ------------------------------------------------------------------------------
# Public backend base URL for Next.js frontend API calls
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Concurrency & Worker Tuning
MAX_CONCURRENT_JOBS=2
WORKER_POLL_INTERVAL=3.0
MAX_VIDEO_DURATION_MINUTES=35
MAX_UPLOAD_SIZE_MB=500
